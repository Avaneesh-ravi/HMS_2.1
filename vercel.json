{
  "builds": [
    {
      "src": "HMS_V2.2/router.php",
      "use": "vercel-php@0.9.0",
      "config": {
        "includeFiles": [
          "HMS_V2.2/api/**/*.php",
          "HMS_V2.2/frontend/**",
          "HMS_V2.2/backend/**/*.php",
          "HMS_V2.2/includes/**/*.php"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/HMS_V2.2/router.php"
    }
  ]
}
